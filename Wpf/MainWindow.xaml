<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess Maze"
        Height="850"
        Width="750"
        MinHeight="700"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#151923">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="CHESS MAZE"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,15"/>

        <!-- Chessboard -->
        <Viewbox Grid.Row="1" Stretch="Uniform">
            <UniformGrid x:Name="Board"
                         Rows="6"
                         Columns="6"
                         Width="540"
                         Height="540"/>
        </Viewbox>

        <!-- Bottom controls -->
        <Border Grid.Row="2"
                Background="#202938"
                CornerRadius="10"
                Padding="12"
                Margin="0,15,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="GAME STATUS"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="StatusText"
                               Text="Select a destination."
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,8,0,12"/>

                    <TextBlock x:Name="MoveCountText"
                               Text="Moves: 0"
                               Foreground="#CBD5E1"
                               FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="MOVE HISTORY"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <ListBox x:Name="MoveHistoryList"
                             Background="#151923"
                             Foreground="White"
                             BorderThickness="0"
                             FontSize="12"/>
                </StackPanel>

                <Button x:Name="RestartButton"
                        Grid.Column="2"
                        Content="Restart"
                        Click="RestartButton_Click"
                        Background="#6366F1"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="15,8"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
